#!/bin/sh /etc/rc.common
START=95
STOP=05
USE_PROCD=1
start_service() {
    procd_open_instance amneziawg
    procd_set_param command /usr/bin/python3 /opt/photonicat-vpn/manager.py awg-run
    procd_set_param respawn 3600 5 5
    procd_set_param stderr 1
    procd_close_instance
    procd_open_instance mihomo
    procd_set_param command /opt/photonicat-vpn/mihomo -d /etc/photonicat-vpn/mihomo -f /etc/photonicat-vpn/mihomo/config.json
    procd_set_param respawn 3600 5 5
    procd_set_param stderr 0
    procd_set_param stdout 0
    procd_close_instance
    procd_open_instance routes
    procd_set_param command /usr/bin/python3 /opt/photonicat-vpn/manager.py monitor
    procd_set_param respawn 3600 5 5
    procd_set_param stderr 1
    procd_close_instance
}
stop_service() {
    /usr/bin/python3 /opt/photonicat-vpn/manager.py cleanup
}
