#!/bin/sh /etc/rc.common
# Guard is installed before network and firewall start.
START=18
STOP=89
USE_PROCD=1
start_service() {
    /usr/bin/python3 /opt/photonicat-vpn/manager.py ports-guard || return 1
    procd_open_instance
    procd_set_param command /usr/bin/python3 /opt/photonicat-vpn/manager.py ports-monitor
    procd_set_param respawn 3600 3 5
    procd_set_param stderr 1
    procd_close_instance
}
# Intentionally retain the guard on stop, including when VPN is stopped.
